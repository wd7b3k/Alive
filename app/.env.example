# Только публичные browser-safe значения. Никогда не добавлять service role key или OAuth client secret.
#
# Здесь перечислены все шесть переменных, которые читает код. Раньше их было три, и
# отсутствие остальных в примере выглядело как «их не существует»: список кнопок входа,
# счётчик Метрики и счётчик GA задаются именно отсюда.

# Адрес Supabase. На self-hosted это тот же домен, что и у приложения.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Публичный (anon / publishable) ключ. Секретный ключ сюда не кладётся никогда.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Адрес, на который провайдер входа возвращает человека.
VITE_APP_ORIGIN=http://localhost:5173

# Способы входа через запятую. Пусто — только Google.
# На проде: google,yandex — Яндекс идёт через собственный мост, см. docs/AUTH_PROVIDERS.md.
VITE_AUTH_PROVIDERS=google

# Номер счётчика Яндекс Метрики. Пусто — счётчик не грузится вовсе.
# Вебвизор включать нельзя: см. docs/SEO_AND_ANALYTICS.md.
VITE_YANDEX_METRIKA_ID=

# Идентификатор потока Google Analytics 4. Осознанно остаётся пустым:
# googletagmanager.com — внешний сервис в рантайме у каждого посетителя,
# что запрещено принципом self-hosted-контура. Решение, а не недоделка.
VITE_GA_MEASUREMENT_ID=
