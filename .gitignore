# появляется здесь, — след случайного `npm install` не в той папке, и однажды такой
# след едва не заехал в индекс на 759 файлов вместе с чужими node_modules.
/package.json
/package-lock.json
app/dist/
# собранная страница доски: артефакт сборки, не исходник
dist/
app/.env.local
app/.env.*.local
.DS_Store
*.log

