# Habitoff local/runtime artifacts
app/node_modules/
node_modules/
# В корне репозитория своего package.json нет: приложение живёт в app/. Всё, что
# появляется здесь, — след случайного `npm install` не в той папке, и однажды такой
# след едва не заехал в индекс на 759 файлов вместе с чужими node_modules.
/package.json
/package-lock.json
app/dist/
# Разобранная история репозитория для раздела «Что сделано»: файл производный, его
# собирает scripts/build-changelog.mjs перед сборкой, типами, тестами и dev-сервером.
# Коммитить его значит завести второй источник истины рядом с git — ADR-0018.
app/src/generated/
# собранная страница доски: артефакт сборки, не исходник
dist/
app/.env.local
app/.env.*.local
.DS_Store
*.log

# Supabase local state
supabase/.temp/
.supabase/

# локальные переменные окружения — секреты в git не место
.env
.env.local
.env.*.local
