# Пример /etc/habitoff-alerts.env на втором сервере. Права 600, владелец root.
# Настоящий токен в git не попадает никогда.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Общий секрет с боевым сервером: тот же, что HEARTBEAT_TOKEN в /etc/habitoff-monitoring.env.
HABITOFF_TOKEN=
WATCHDOG_PORT=8787
PROBE_URL=https://habitoff.ru/
HEARTBEAT_GRACE_SECONDS=900
DIGEST_HOUR_MSK=10
