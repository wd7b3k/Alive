[Unit]
Description=Habitoff: сообщить о сбое юнита %i

[Service]
Type=oneshot
EnvironmentFile=/etc/habitoff-monitoring.env
ExecStart=/bin/bash -c '/usr/bin/curl -sS --max-time 10 -X POST "$WATCHDOG_URL/alert" \
  -H "X-Habitoff-Token: $HEARTBEAT_TOKEN" -H "Content-Type: application/json" \
  -d "{\"level\":\"critical\",\"check\":\"systemd\",\"detail\":{\"unit\":\"%i\"}}" -o /dev/null'
User=root
