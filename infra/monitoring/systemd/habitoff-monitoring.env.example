# Пример /etc/habitoff-monitoring.env — на сервере права 600, владелец root.
# В git этот файл попадает только как пример: настоящих значений здесь нет и не будет.
HABITOFF_ORIGIN=https://habitoff.ru
SUPABASE_DIR=/srv/supabase
APP_DIR=/srv/alive
# Клон, из которого собирается прод: отпечаток сборки сверяет живой коммит с origin/main.
REPO_DIR=/srv/alive/repo
# Каталог бэкапов и состояние, которое пишет о себе /usr/local/bin/habitoff-backup.
BACKUP_DIR=/srv/alive/backups
BACKUP_STATE_DIR=/var/lib/habitoff
DB_CONTAINER=supabase-db
CADDY_ACCESS_LOG=/var/log/caddy/access.log
# Публичный ключ anon — тот же, что уходит в браузер посетителя.
SUPABASE_ANON_KEY=
# Сообщения уходят через /usr/local/bin/habitoff-notify — он уже стоит на сервере и
# знает токен из /etc/habitoff/backup.env. Отдельный канал здесь не заводится.
NOTIFY_BIN=/usr/local/bin/habitoff-notify
# Сторож на втором сервере: ему уходит пульс. Алерты через него — только запасной путь,
# на случай если notify недоступен.
WATCHDOG_URL=http://ЗАМЕНИТЬ:8787
HEARTBEAT_TOKEN=
