# Пример /etc/habitoff-monitoring.env — на сервере права 600, владелец root.
# В git этот файл попадает только как пример: настоящих значений здесь нет и не будет.
HABITOFF_ORIGIN=https://habitoff.ru
SUPABASE_DIR=/srv/supabase
APP_DIR=/srv/alive
BACKUP_DIR=/srv/backups
DB_CONTAINER=supabase-db
CADDY_ACCESS_LOG=/var/log/caddy/access.log
# Публичный ключ anon — тот же, что уходит в браузер посетителя.
SUPABASE_ANON_KEY=
# Сторож на втором сервере: адрес и общий секрет. Токена Telegram здесь нет — он живёт
# только на втором сервере, чтобы взлом боевого сервера не отдавал вместе с ним бота.
WATCHDOG_URL=http://ЗАМЕНИТЬ:8787
HEARTBEAT_TOKEN=
