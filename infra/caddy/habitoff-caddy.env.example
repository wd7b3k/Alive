# Пример /etc/habitoff-caddy.env — на сервере права 600, владелец root.
# В git этот файл попадает только как пример: настоящего значения здесь нет и не будет.
#
# Публикуемый ключ Supabase — тот же, что уезжает в браузер посетителя. Секретом он не
# является, но живёт на сервере, чтобы ротация была правкой одного файла, а не коммитом.
HABITOFF_SUPABASE_PUBLISHABLE_KEY=
