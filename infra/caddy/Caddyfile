# Веб-сервер Habitoff. Канонический источник — этот файл, а не /etc/caddy/Caddyfile.
#
# До 30.08.2026 конфигурация жила только на сервере, и это определяло всё, что аудит
# видимости нашёл снаружи: подстановку index.html на неизвестный путь, отсутствие
# content-type у манифеста, заголовки кэширования. Починить их «из репозитория» было
# нельзя — только руками по ssh, ровно тем способом, от которого проект ушёл.
#
# Порядок установки и проверка — infra/caddy/README.md.

habitoff.ru {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
	encode zstd gzip

	# Шлюз Supabase. Заголовок apikey подставляется потому, что шлюз требует его на всех
	# путях, а браузер при переходе по ссылке заголовков не шлёт — и Яндекс, возвращая
	# человека на callback, тем более. Без подстановки вход упирался бы в 401.
	#
	# Ключ публикуемый — тот же, что уезжает в браузер, — но в репозитории его нет:
	# при ротации значение меняется в одном месте на сервере, а не коммитом. Значение
	# приходит из EnvironmentFile, см. caddy.service.d/habitoff-env.conf.
	handle /functions/v1/yandex/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up apikey "{env.HABITOFF_SUPABASE_PUBLISHABLE_KEY}"
		}
	}
	handle /rest/v1/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /auth/v1/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /functions/v1/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /srv/alive/current

		# Имя чанка содержит хэш содержимого: такой файл можно кэшировать год, он не
		# меняется никогда. Матчер на втором заголовке обязателен — без него `header`
		# без матчера перезаписывает Cache-Control всем, включая /assets/*, и год
		# превращается в no-cache. Именно это и происходило: документ обещал immutable,
		# сервер отдавал no-cache, и заметили это только замером снаружи.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@not-assets not path /assets/*
		header @not-assets Cache-Control "no-cache"

		# Расширения .webmanifest Caddy не знает и заголовок не ставит вовсе; браузер в
		# этом случае считает файл текстом.
		header /site.webmanifest Content-Type "application/manifest+json"

		# Запрет индексации личных экранов. Заголовком, а не мета-тегом и не robots.txt —
		# и это единственная форма, которая здесь работает.
		#
		# Мета-тег `noindex` ставит JavaScript, которого краулер не выполняет. `Disallow`
		# в robots.txt запрещает обход, а не показ: робот, которому запрещено зайти, не
		# увидит там запрета и вправе оставить адрес в выдаче голой ссылкой. Узнать адрес
		# ему теперь есть откуда — 05.09.2026 включён обход по счётчикам Метрики, а
		# счётчик по ADR-0015 стоит и на личных страницах.
		#
		# Поэтому `Disallow` для этих путей снят, обход разрешён, а запрет вернулся сюда:
		# чтобы `noindex` сработал, робот обязан его увидеть.
		#
		# Список путей сверяется с `src/services/seo.ts` тестом `services/robots.test.ts`.
		@private path /profile /profile/* /health /health/* /path /path/* /together /together/* /admin /admin/* /login /login/*
		header @private X-Robots-Tag "noindex, nofollow"

		route {
			# Экраны, которые рисует клиент: своего файла у них нет и быть не может.
			# Список сверяется с src/services/seo.ts тестом services/caddy-routes.test.ts —
			# забытый здесь новый раздел начал бы отдавать 404 при обновлении страницы,
			# и это хуже мягкого 404, ради которого всё затевалось.
			@app path / /profile /health /path /together /login /admin /admin/*
			rewrite @app /index.html

			# Слой статей базы знаний, проживший 05.09.2026 несколько часов. Девятнадцать
			# адресов успели уйти в Яндекс.Вебмастер на переобход, а карта сайта с ними —
			# в Google. Просто убрать файлы значит оставить эти адреса в очереди обхода
			# надолго: 404 поисковик читает как «сейчас нет, зайду ещё».
			#
			# 410 означает «удалено намеренно», и адрес выпадает из очереди заметно
			# быстрее. Правило временное — до конца октября 2026, снятие отдельной
			# карточкой доски: к тому времени очередь опустеет, и адреса станут обычными
			# несуществующими.
			@gone path /knowledge/novoe /knowledge/novoe/* /knowledge/telo-posle-otkaza /knowledge/telo-posle-otkaza/* /knowledge/method /knowledge/updates/*
			handle @gone {
				header Content-Type "text/html; charset=utf-8"
				respond `<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="robots" content="noindex"><title>Страница удалена — Habitoff</title></head><body><h1>Эта страница удалена</h1><p>Разборы перестали быть отдельным разделом: то, что в них было, живёт в карточках «Фактов и мифов» — у каждой свой адрес, уровень доказательности, границы и источник.</p><p><a href="/knowledge">Факты и мифы</a></p></body></html>` 410
			}

			# Всё остальное — только то, что действительно лежит на диске. Публичные
			# разделы лежат: сборка раскладывает knowledge/index.html и остальные четыре.
			# Не нашлось ничего — 404, а не подставленная главная: мягкий 404 приглашает
			# поисковик индексировать бесконечное число адресов, а человеку, ошибшемуся в
			# ссылке, молча подсовывает другую страницу.
			try_files {path} {path}/index.html
			file_server
		}
	}

	# Тело для несуществующего адреса. Код 404 отдавался и раньше, но с телом нулевой
	# длины: человек видел белый экран, робот — пустой документ. Файл 404.html
	# раскладывает та же сборка, что и разделы.
	#
	# Блок стоит на уровне сайта, а не внутри `handle`: `handle_errors` не является
	# упорядоченным обработчиком, и Caddy отказывается его разбирать вложенным —
	# `caddy validate` говорит это прямо. Поэтому `root` здесь задаётся заново: своего
	# он от соседнего блока не наследует.
	#
	# `status` обязателен: без него file_server отдал бы страницу с кодом 200, то есть
	# мягкий 404 вернулся бы через заднюю дверь — с той разницей, что теперь он
	# выглядел бы починенным.
	handle_errors {
		root * /srv/alive/current
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

www.habitoff.ru {
	redir https://habitoff.ru{uri} permanent
}
