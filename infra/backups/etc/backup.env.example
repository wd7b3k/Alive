# Секреты подсистемы резервного копирования Habitoff.
#
# Права 600, владелец root. В git не попадает никогда — файл живёт только здесь.
# Заполните четыре верхних значения; два токена Яндекса пропишет скрипт сам.

# --- Яндекс.Диск: приложение с правом cloud_api:disk.app_folder ---
YADISK_CLIENT_ID=
YADISK_CLIENT_SECRET=

# Заполняются автоматически (habitoff-yadisk token <код>). Руками не трогать.
YADISK_ACCESS_TOKEN=
YADISK_REFRESH_TOKEN=
YADISK_TOKEN_OBTAINED=

# --- Шифрование уезжающих копий ---
# Придумайте длинный пароль и СОХРАНИТЕ ЕГО В МЕНЕДЖЕРЕ ПАРОЛЕЙ.
# Без него копии на Яндекс.Диске бесполезны — расшифровать их будет нечем.
BACKUP_PASSPHRASE=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Глубина хранения ---
KEEP_LOCAL_DAYS=7
KEEP_REMOTE_DAYS=14
